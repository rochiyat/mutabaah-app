DATABASE_URL="mysql://user:password@host:port/database"
# Wajib, minimal 32 karakter acak. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
NODE_ENV="development"
PORT=3000

# Isi jika server berjalan di belakang reverse proxy/hosting (jumlah proxy, biasanya 1),
# supaya pembatasan login per IP membaca IP asli pengguna. Kosongkan jika tidak ada proxy.
TRUST_PROXY=""

# Dipakai oleh `npm run prisma:seed` untuk membuat akun superadmin pertama
SEED_SUPERADMIN_EMAIL="superadmin@mutabaah.com"
SEED_SUPERADMIN_PASSWORD=""
