generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  // Peran tambahan (JSON array), misal ["murabbi","bendahara"]; [] = anggota biasa
  roles     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            GroupMember[]
  adminGroups            Group[]              @relation("GroupAdmin")
  activities             Activity[]
  records                Record[]
  kajianCreated          Kajian[]             @relation("KajianCreator")
  meetingsCreated        Meeting[]            @relation("MeetingCreator")
  attendances            Attendance[]         @relation("AttendanceUser")
  attendancesRecorded    Attendance[]         @relation("AttendanceRecorder")
  financeAccountsCreated FinanceAccount[]     @relation("FinanceAccountCreator")
  transactionsCreated    Transaction[]        @relation("TransactionCreator")
  transactionsAsMember   Transaction[]        @relation("TransactionMember")
  programsLed            Program[]            @relation("ProgramPic")
  programsCreated        Program[]            @relation("ProgramCreator")
  programParticipations  ProgramParticipant[]
}

// Group = halaqoh / kelompok binaan. adminId = murabbi penanggung jawab.
model Group {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  level       String? // jenjang, mis. "Pemula", "Madya"
  schedule    String? // jadwal pertemuan, mis. "Ahad 08.00"
  location    String? // tempat atau link online
  adminId     Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin           User             @relation("GroupAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  members         GroupMember[]
  activities      GroupActivity[]
  meetings        Meeting[]
  financeAccounts FinanceAccount[]
  programs        Program[]

  @@index([adminId])
}

// Keanggotaan halaqoh. role: "murabbi" (ikut mengelola) atau "mutarabbi" (peserta)
model GroupMember {
  id       Int      @id @default(autoincrement())
  groupId  Int
  userId   Int
  role     String   @default("mutarabbi")
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Activity {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  target    Int      @default(1)
  unit      String   @default("kali")
  isActive  Boolean  @default(true)
  userId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupActivities GroupActivity[]
  records         Record[]

  @@index([userId])
}

model GroupActivity {
  id         Int      @id @default(autoincrement())
  groupId    Int
  activityId Int
  isRequired Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([groupId, activityId])
  @@index([groupId])
  @@index([activityId])
}

model Record {
  id         Int      @id @default(autoincrement())
  date       DateTime @db.Date
  completed  Int      @default(0)
  notes      String?  @db.Text
  activityId Int
  userId     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, date, userId])
  @@index([userId, date])
}

// Kajian rutin lembaga (terbuka untuk semua anggota)
model Kajian {
  id          Int      @id @default(autoincrement())
  title       String
  speaker     String? // ustadz / pemateri tetap
  description String?  @db.Text
  schedule    String? // mis. "Setiap Kamis ba'da Maghrib"
  location    String?
  isActive    Boolean  @default(true)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?     @relation("KajianCreator", fields: [createdById], references: [id], onDelete: SetNull)
  meetings  Meeting[]

  @@index([createdById])
}

// Satu sesi pertemuan, milik halaqoh (groupId) ATAU kajian (kajianId)
model Meeting {
  id          Int      @id @default(autoincrement())
  groupId     Int?
  kajianId    Int?
  date        DateTime @db.Date
  startTime   String? // "HH:mm"
  topic       String // materi / tema
  speaker     String? // pemateri sesi ini
  location    String?
  notes       String?  @db.Text
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kajian      Kajian?      @relation(fields: [kajianId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attendances Attendance[]

  @@index([groupId, date])
  @@index([kajianId, date])
  @@index([createdById])
}

// Kehadiran. status: hadir | izin | sakit | alpa
model Attendance {
  id           Int      @id @default(autoincrement())
  meetingId    Int
  userId       Int
  status       String
  note         String?
  recordedById Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user       User    @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([meetingId, userId])
  @@index([userId])
  @@index([recordedById])
}

// Kas: milik lembaga (groupId null) atau milik halaqoh
model FinanceAccount {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?  @db.Text
  groupId        Int?
  openingBalance Decimal  @default(0) @db.Decimal(15, 2)
  isActive       Boolean  @default(true)
  createdById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group        Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("FinanceAccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]
  duesPlans    DuesPlan[]

  @@index([groupId])
  @@index([createdById])
}

// Transaksi kas. type: masuk | keluar
model Transaction {
  id          Int      @id @default(autoincrement())
  accountId   Int
  type        String
  category    String
  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime @db.Date
  description String?
  memberId    Int? // anggota pembayar (infaq/iuran) atau penerima
  programId   Int?
  duesPlanId  Int?
  duesPeriod  String? // "yyyy-MM" untuk pembayaran iuran
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account   FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  member    User?          @relation("TransactionMember", fields: [memberId], references: [id], onDelete: SetNull)
  program   Program?       @relation(fields: [programId], references: [id], onDelete: SetNull)
  duesPlan  DuesPlan?      @relation(fields: [duesPlanId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([accountId, date])
  @@index([memberId])
  @@index([programId])
  @@index([duesPlanId, duesPeriod])
  @@index([createdById])
}

// Iuran rutin bulanan pada sebuah kas
model DuesPlan {
  id        Int      @id @default(autoincrement())
  accountId Int
  name      String
  amount    Decimal  @db.Decimal(15, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account      FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([accountId])
}

// Program kerja lembaga atau halaqoh. status: rencana | berjalan | selesai | batal
model Program {
  id          Int       @id @default(autoincrement())
  name        String
  description String?   @db.Text
  groupId     Int?
  status      String    @default("rencana")
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  location    String?
  budget      Decimal?  @db.Decimal(15, 2)
  picId       Int?
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group        Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pic          User?                @relation("ProgramPic", fields: [picId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("ProgramCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ProgramParticipant[]
  transactions Transaction[]

  @@index([groupId])
  @@index([picId])
  @@index([createdById])
}

// role: panitia | peserta
model ProgramParticipant {
  id        Int      @id @default(autoincrement())
  programId Int
  userId    Int
  role      String   @default("peserta")
  joinedAt  DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([userId])
}
